                 bindings.append(
                     {
                         "binding": index,
-                        "resource": wgpu_object.create_view(
-                            usage=wgpu.TextureUsage.STORAGE_BINDING
-                        ),
+                        # A view with all the usages of the texture, not only
+                        # STORAGE_BINDING: the usage that is needed depends on how the
